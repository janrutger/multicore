{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ZScript Assembly",
  "scopeName": "source.zscript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#labels" },
    { "include": "#instructions" },
    { "include": "#registers" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#memory_ref" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.zscript",
          "match": ";.*$"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.other.directive.zscript",
          "match": "(?i)\\b(MAP|MEMORY|PROGRAM|INCLUDE|SHARED|PRIVATE|START|CONST|IO|SP|MACRO|REPEAT|TIMES|UNTIL|IF|ELSE|TRUE|FALSE|ZERO|SPAWN|UPDATE|HARVEST|WRITE|READ|ATOMIC)\\b"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.function.label.zscript",
          "match": "^\\s*([a-zA-Z_][a-zA-Z0-9_\\-]*):"
        }
      ]
    },
    "instructions": {
      "patterns": [
        {
          "name": "keyword.control.instruction.zscript",
          "match": "%%INSTRUCTION_REGEX%%"
        }
      ]
    },
    "registers": {
      "patterns": [
        {
          "name": "variable.language.register.zscript",
          "match": "%%REGISTER_REGEX%%"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.zscript",
          "match": "(->|==|!=|>|<|\\+|\\-)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.zscript",
          "match": "\\b-?\\d+\\b"
        }
      ]
    },
    "memory_ref": {
      "patterns": [
        {
          "name": "variable.parameter.memory.zscript",
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            { "include": "#registers" },
            { "include": "#numbers" },
            { "include": "#operators" }
          ]
        }
      ]
    }
  }
}