{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ZScript Assembly",
  "scopeName": "source.zscript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#labels" },
    { "include": "#instructions" },
    { "include": "#registers" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#memory_ref" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.zscript",
          "match": ";.*$"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.other.directive.zscript",
          "match": "(?i)\\b(MAP|MEMORY|PROGRAM|INCLUDE|SHARED|PRIVATE|START|CONST|IO|SP|MACRO|REPEAT|TIMES|UNTIL|IF|ELSE|TRUE|FALSE|ZERO|SPAWN|UPDATE|HARVEST|WRITE|READ|ATOMIC)\\b"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.function.label.zscript",
          "match": "^\\s*([a-zA-Z_][a-zA-Z0-9_\\-]*):"
        }
      ]
    },
    "instructions": {
      "patterns": [
        {
          "name": "keyword.control.instruction.zscript",
          "match": "(?i)\\b(ADD|ADDI|ALLSYNC|ANDI|AUTOCLOSE|CLOSE|CONTEXT|CPUID|DEC|DIV|DIVI|FAIL|HALT|IN|INC|IOSYNC|JMP|JMPF|JMPT|JOIN|LD|LDI|LDM|LDX|LOCK|MOD|MSG_CLOSE|MSG_DONE|MSG_OPEN|MSG_PROBE|MSG_READ|MSG_START|MSG_WRITE|MUL|MULI|NOP|OUT|PID|RBOOT|RCONTEXT|RND32|ROTL32|SHIFTL|SHIFTR|STO|STX|SUB|SUBI|SUCCES|SUSPEND|SYNC|TST|TSTE|TSTG|TSTZ|UNLOCK|XOR)\\b"
        }
      ]
    },
    "registers": {
      "patterns": [
        {
          "name": "variable.language.register.zscript",
          "match": "(?i)\\b(A|B|C|I|K|L|M|PC|R0|R1|R2|R3|R4|R5|R6|R7|R8|R9|SP|X|Y|Z)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.zscript",
          "match": "(->|==|!=|>|<|\\+|\\-)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.zscript",
          "match": "\\b-?\\d+\\b"
        }
      ]
    },
    "memory_ref": {
      "patterns": [
        {
          "name": "variable.parameter.memory.zscript",
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            { "include": "#registers" },
            { "include": "#numbers" },
            { "include": "#operators" }
          ]
        }
      ]
    }
  }
}